# Copia a .env (NUNCA lo subas a Git). En producción usa un gestor de secretos / KMS.
# Fase 1 (scanner.py) no necesita ninguna de estas variables.

# --- Polymarket ---
POLY_PRIVATE_KEY=            # L1: solo dev. En prod: KMS_KEY_ID con firma remota
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=0        # 0 EOA, 1 proxy email/Magic, 2 Gnosis Safe
POLY_API_KEY=                # L2 (HMAC)
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Kalshi ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=     # ruta a la clave RSA (chmod 600), o KMS

# --- Modo ---
TRADING_MODE=shadow          # shadow | live
